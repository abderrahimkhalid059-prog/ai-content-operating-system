generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WebsitePlatform {
  BLOGGER
  WORDPRESS
  OTHER
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  SEO_MANAGER
  WRITER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContentProfileStatus {
  ACTIVE
  INACTIVE
}

enum JobRecordStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

enum PublishingProviderType {
  BLOGGER
  WORDPRESS
  OTHER
}

enum IntegrationMode {
  MOCK
  LIVE
}

enum WebsiteConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum ExternalPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  DELETED
}

enum ExternalTaxonomyType {
  LABEL
}

enum IntegrationSyncType {
  FULL
  POSTS
  LABELS
  TEST
}

enum IntegrationSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderPublicationOperation {
  CREATE_DRAFT
  UPDATE_POST
  PUBLISH_POST
  DELETE_POST
}

enum ProviderPublicationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ContentEditorialStatus {
  IDEA
  RESEARCHING
  OUTLINED
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  ARCHIVED
}

enum ContentPublicationStatus {
  NOT_PUBLISHED
  DRAFT_SENT
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ContentCommentStatus {
  OPEN
  RESOLVED
}

enum ContentReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum ContentPublicationBindingStatus {
  PENDING
  ACTIVE
  MISSING
  ERROR
}

model User {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String              @unique @db.VarChar(320)
  displayName          String?             @map("display_name") @db.VarChar(120)
  passwordHash         String              @map("password_hash") @db.VarChar(255)
  status               UserStatus          @default(ACTIVE)
  mustChangePassword   Boolean             @default(true) @map("must_change_password")
  securityVersion      Int                 @default(1) @map("security_version")
  lastLoginAt          DateTime?           @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt    DateTime?           @map("password_changed_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspaceMembers     WorkspaceMember[]
  sessions             Session[]
  auditLogs            AuditLog[]          @relation("AuditActor")
  connectedProviders   WebsiteConnection[] @relation("ProviderConnectedBy")
  oauthStates          OAuthState[]        @relation("OAuthStateUser")
  createdContentItems  ContentItem[]       @relation("ContentCreatedBy")
  assignedContentItems ContentItem[]       @relation("ContentAssignedTo")
  contentRevisions     ContentRevision[]   @relation("ContentRevisionChangedBy")
  contentComments      ContentComment[]    @relation("ContentCommentAuthor")
  resolvedComments     ContentComment[]    @relation("ContentCommentResolver")
  contentReviews       ContentReview[]     @relation("ContentReviewer")

  @@map("users")
}

model Workspace {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(120)
  slug                String               @unique @db.VarChar(100)
  isActive            Boolean              @default(true) @map("is_active")
  deactivatedAt       DateTime?            @map("deactivated_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members             WorkspaceMember[]
  websites            Website[]
  settings            SystemSetting[]
  auditLogs           AuditLog[]
  jobRecords          JobRecord[]
  websiteConnections  WebsiteConnection[]
  oauthStates         OAuthState[]
  contentItems        ContentItem[]
  contentRevisions    ContentRevision[]
  contentComments     ContentComment[]
  contentReviews      ContentReview[]
  contentPublications ContentPublication[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Website {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  name                String               @db.VarChar(160)
  slug                String               @db.VarChar(120)
  platform            WebsitePlatform
  language            String               @db.VarChar(10)
  locale              String?              @db.VarChar(35)
  timezone            String               @db.VarChar(64)
  description         String?              @db.VarChar(1000)
  status              WebsiteStatus        @default(DRAFT)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]
  jobRecords          JobRecord[]
  contentProfiles     ContentProfile[]
  connections         WebsiteConnection[]
  oauthStates         OAuthState[]
  contentItems        ContentItem[]
  contentRevisions    ContentRevision[]
  contentComments     ContentComment[]
  contentReviews      ContentReview[]
  contentPublications ContentPublication[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("websites")
}

model SystemSetting {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  key         String     @db.VarChar(120)
  value       Json
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([key])
  @@map("system_settings")
}

model AuditLog {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String?    @map("workspace_id") @db.Uuid
  websiteId     String?    @map("website_id") @db.Uuid
  actorUserId   String?    @map("user_id") @db.Uuid
  targetType    String?    @map("target_type") @db.VarChar(80)
  targetId      String?    @map("target_id") @db.Uuid
  action        String     @db.VarChar(120)
  requestId     String?    @map("request_id") @db.VarChar(128)
  correlationId String?    @map("correlation_id") @db.VarChar(128)
  ipAddress     String?    @map("ip_address") @db.VarChar(64)
  userAgent     String?    @map("user_agent") @db.VarChar(512)
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  website       Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  actor         User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([websiteId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @map("token_hash") @db.VarChar(128)
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("sessions")
}

model ContentProfile {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  websiteId        String               @map("website_id") @db.Uuid
  name             String               @db.VarChar(160)
  language         String               @db.VarChar(10)
  locale           String?              @db.VarChar(35)
  countryCode      String?              @map("country_code") @db.Char(2)
  tone             String               @db.VarChar(300)
  targetAudience   String?              @map("target_audience") @db.VarChar(500)
  editorialRules   Json                 @map("editorial_rules")
  prohibitedTopics Json?                @map("prohibited_topics")
  isDefault        Boolean              @default(false) @map("is_default")
  status           ContentProfileStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  website          Website              @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contentItems     ContentItem[]

  @@unique([websiteId, name])
  @@unique([id, workspaceId, websiteId])
  @@index([workspaceId, websiteId, status])
  @@index([websiteId, isDefault, status])
  @@map("content_profiles")
}

model ContentItem {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String                   @map("workspace_id") @db.Uuid
  websiteId               String                   @map("website_id") @db.Uuid
  contentProfileId        String?                  @map("content_profile_id") @db.Uuid
  title                   String                   @db.VarChar(300)
  slug                    String                   @db.VarChar(120)
  excerpt                 String?                  @db.VarChar(1000)
  htmlContent             String                   @map("html_content") @db.Text
  plainTextContent        String                   @map("plain_text_content") @db.Text
  metaTitle               String?                  @map("meta_title") @db.VarChar(70)
  metaDescription         String?                  @map("meta_description") @db.VarChar(180)
  canonicalUrl            String?                  @map("canonical_url") @db.VarChar(1500)
  language                String                   @db.VarChar(10)
  locale                  String?                  @db.VarChar(35)
  featuredImageReference  String?                  @map("featured_image_reference") @db.VarChar(1000)
  labels                  Json
  wordCount               Int                      @map("word_count")
  estimatedReadingMinutes Int                      @map("estimated_reading_minutes")
  editorialStatus         ContentEditorialStatus   @default(IDEA) @map("editorial_status")
  publicationStatus       ContentPublicationStatus @default(NOT_PUBLISHED) @map("publication_status")
  version                 Int                      @default(1)
  createdByUserId         String                   @map("created_by_user_id") @db.Uuid
  assignedToUserId        String?                  @map("assigned_to_user_id") @db.Uuid
  archivedAt              DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website                 Website                  @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contentProfile          ContentProfile?          @relation(fields: [contentProfileId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Restrict)
  createdBy               User                     @relation("ContentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo              User?                    @relation("ContentAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  revisions               ContentRevision[]
  comments                ContentComment[]
  reviews                 ContentReview[]
  publications            ContentPublication[]

  @@unique([workspaceId, websiteId, slug])
  @@unique([id, workspaceId, websiteId])
  @@index([workspaceId, websiteId, editorialStatus, updatedAt], map: "content_items_workspace_id_website_id_editorial_status_updated_")
  @@index([workspaceId, websiteId, publicationStatus, updatedAt], map: "content_items_workspace_id_website_id_publication_status_update")
  @@index([workspaceId, websiteId, assignedToUserId])
  @@index([workspaceId, websiteId, createdByUserId])
  @@index([workspaceId, websiteId, contentProfileId])
  @@map("content_items")
}

model ContentRevision {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String                   @map("workspace_id") @db.Uuid
  websiteId               String                   @map("website_id") @db.Uuid
  contentItemId           String                   @map("content_item_id") @db.Uuid
  revisionNumber          Int                      @map("revision_number")
  title                   String                   @db.VarChar(300)
  slug                    String                   @db.VarChar(120)
  excerpt                 String?                  @db.VarChar(1000)
  htmlContent             String                   @map("html_content") @db.Text
  plainTextContent        String                   @map("plain_text_content") @db.Text
  metaTitle               String?                  @map("meta_title") @db.VarChar(70)
  metaDescription         String?                  @map("meta_description") @db.VarChar(180)
  canonicalUrl            String?                  @map("canonical_url") @db.VarChar(1500)
  language                String                   @db.VarChar(10)
  locale                  String?                  @db.VarChar(35)
  featuredImageReference  String?                  @map("featured_image_reference") @db.VarChar(1000)
  labels                  Json
  wordCount               Int                      @map("word_count")
  estimatedReadingMinutes Int                      @map("estimated_reading_minutes")
  editorialStatus         ContentEditorialStatus   @map("editorial_status")
  publicationStatus       ContentPublicationStatus @map("publication_status")
  assignedToUserId        String?                  @map("assigned_to_user_id") @db.Uuid
  contentProfileId        String?                  @map("content_profile_id") @db.Uuid
  changedByUserId         String                   @map("changed_by_user_id") @db.Uuid
  changeReason            String?                  @map("change_reason") @db.VarChar(500)
  changedAt               DateTime                 @default(now()) @map("changed_at") @db.Timestamptz(3)
  contentItem             ContentItem              @relation(fields: [contentItemId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website                 Website                  @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  changedBy               User                     @relation("ContentRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  reviews                 ContentReview[]

  @@unique([contentItemId, revisionNumber])
  @@unique([id, workspaceId, websiteId, contentItemId], map: "content_revisions_id_workspace_id_website_id_content_item_id_ke")
  @@index([workspaceId, websiteId, contentItemId, revisionNumber], map: "content_revisions_workspace_id_website_id_content_item_id_revis")
  @@map("content_revisions")
}

model ContentComment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  websiteId        String               @map("website_id") @db.Uuid
  contentItemId    String               @map("content_item_id") @db.Uuid
  authorUserId     String               @map("author_user_id") @db.Uuid
  message          String               @db.VarChar(4000)
  status           ContentCommentStatus @default(OPEN)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website          Website              @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contentItem      ContentItem          @relation(fields: [contentItemId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)
  author           User                 @relation("ContentCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  resolvedBy       User?                @relation("ContentCommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId, websiteId, contentItemId])
  @@index([workspaceId, websiteId, contentItemId, status, createdAt], map: "content_comments_workspace_id_website_id_content_item_id_status")
  @@map("content_comments")
}

model ContentReview {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String                @map("workspace_id") @db.Uuid
  websiteId              String                @map("website_id") @db.Uuid
  contentItemId          String                @map("content_item_id") @db.Uuid
  contentRevisionId      String                @map("content_revision_id") @db.Uuid
  reviewerUserId         String                @map("reviewer_user_id") @db.Uuid
  decision               ContentReviewDecision
  note                   String?               @db.VarChar(4000)
  reviewedRevisionNumber Int                   @map("reviewed_revision_number")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website                Website               @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contentItem            ContentItem           @relation(fields: [contentItemId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)
  contentRevision        ContentRevision       @relation(fields: [contentRevisionId, workspaceId, websiteId, contentItemId], references: [id, workspaceId, websiteId, contentItemId], onDelete: Restrict, map: "content_reviews_content_revision_id_workspace_id_website_id_con")
  reviewer               User                  @relation("ContentReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, websiteId, contentItemId, createdAt], map: "content_reviews_workspace_id_website_id_content_item_id_created")
  @@index([reviewerUserId, createdAt])
  @@map("content_reviews")
}

model ContentPublication {
  id                             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                    String                          @map("workspace_id") @db.Uuid
  websiteId                      String                          @map("website_id") @db.Uuid
  contentItemId                  String                          @map("content_item_id") @db.Uuid
  connectionId                   String                          @map("connection_id") @db.Uuid
  provider                       PublishingProviderType
  externalSiteId                 String                          @map("external_site_id") @db.VarChar(255)
  externalPostId                 String?                         @map("external_post_id") @db.VarChar(255)
  status                         ContentPublicationBindingStatus @default(PENDING)
  lastSynchronizedRevisionNumber Int?                            @map("last_synchronized_revision_number")
  lastSynchronizedHash           String?                         @map("last_synchronized_hash") @db.Char(64)
  lastErrorCode                  String?                         @map("last_error_code") @db.VarChar(120)
  missingConfirmedAt             DateTime?                       @map("missing_confirmed_at") @db.Timestamptz(3)
  createdAt                      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                      Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website                        Website                         @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contentItem                    ContentItem                     @relation(fields: [contentItemId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade, map: "content_publications_content_item_id_workspace_id_website_id_fk")
  connection                     WebsiteConnection               @relation(fields: [connectionId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Restrict)
  operations                     ProviderPublication[]

  @@unique([id, workspaceId, websiteId])
  @@unique([contentItemId, provider, externalSiteId], map: "content_publications_content_item_id_provider_external_site_id_")
  @@index([workspaceId, websiteId, status, updatedAt], map: "content_publications_workspace_id_website_id_status_updated_at_")
  @@index([connectionId, externalPostId])
  @@map("content_publications")
}

model JobRecord {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalJobId String          @map("external_job_id") @db.VarChar(100)
  queue         String          @db.VarChar(100)
  name          String          @db.VarChar(120)
  status        JobRecordStatus @default(WAITING)
  correlationId String          @map("correlation_id") @db.Uuid
  workspaceId   String?         @map("workspace_id") @db.Uuid
  websiteId     String?         @map("website_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  website       Website?        @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@unique([queue, externalJobId])
  @@index([correlationId])
  @@index([workspaceId, status])
  @@index([websiteId, status])
  @@map("job_records")
}

model WebsiteConnection {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                  @map("workspace_id") @db.Uuid
  websiteId            String                  @map("website_id") @db.Uuid
  provider             PublishingProviderType
  mode                 IntegrationMode
  status               WebsiteConnectionStatus @default(PENDING)
  externalAccountId    String?                 @map("external_account_id") @db.VarChar(255)
  externalSiteId       String?                 @map("external_site_id") @db.VarChar(255)
  externalSiteName     String?                 @map("external_site_name") @db.VarChar(255)
  externalSiteUrl      String?                 @map("external_site_url") @db.VarChar(1000)
  encryptedCredentials String?                 @map("encrypted_credentials") @db.Text
  credentialKeyVersion String?                 @map("credential_key_version") @db.VarChar(50)
  grantedScopes        Json?                   @map("granted_scopes")
  connectedByUserId    String                  @map("connected_by_user_id") @db.Uuid
  connectedAt          DateTime?               @map("connected_at") @db.Timestamptz(3)
  lastTestedAt         DateTime?               @map("last_tested_at") @db.Timestamptz(3)
  lastSuccessfulSyncAt DateTime?               @map("last_successful_sync_at") @db.Timestamptz(3)
  expiresAt            DateTime?               @map("expires_at") @db.Timestamptz(3)
  lastErrorCode        String?                 @map("last_error_code") @db.VarChar(120)
  lastErrorAt          DateTime?               @map("last_error_at") @db.Timestamptz(3)
  metadata             Json?
  revokedAt            DateTime?               @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website              Website                 @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  connectedBy          User                    @relation("ProviderConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Restrict)
  externalPosts        ExternalPost[]
  taxonomyTerms        ExternalTaxonomyTerm[]
  syncRuns             IntegrationSyncRun[]
  publications         ProviderPublication[]
  contentPublications  ContentPublication[]

  @@unique([id, workspaceId, websiteId])
  @@index([workspaceId, status])
  @@index([websiteId, provider, status])
  @@index([provider, externalSiteId])
  @@map("website_connections")
}

model OAuthState {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                 @map("workspace_id") @db.Uuid
  websiteId        String                 @map("website_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  provider         PublishingProviderType
  mode             IntegrationMode
  stateHash        String                 @unique @map("state_hash") @db.Char(64)
  codeVerifierHash String?                @map("code_verifier_hash") @db.Char(64)
  redirectAfter    String                 @map("redirect_after") @db.VarChar(500)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime?              @map("consumed_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website          Website                @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user             User                   @relation("OAuthStateUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, websiteId, provider])
  @@index([expiresAt, consumedAt])
  @@map("oauth_states")
}

model ExternalPost {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String                 @map("workspace_id") @db.Uuid
  websiteId           String                 @map("website_id") @db.Uuid
  connectionId        String                 @map("connection_id") @db.Uuid
  provider            PublishingProviderType
  externalPostId      String                 @map("external_post_id") @db.VarChar(255)
  externalBlogId      String                 @map("external_blog_id") @db.VarChar(255)
  title               String                 @db.VarChar(500)
  slugOrUrl           String?                @map("slug_or_url") @db.VarChar(1500)
  status              ExternalPostStatus
  contentHash         String                 @map("content_hash") @db.Char(64)
  labels              Json
  publishedAt         DateTime?              @map("published_at") @db.Timestamptz(3)
  updatedExternallyAt DateTime?              @map("updated_externally_at") @db.Timestamptz(3)
  lastImportedAt      DateTime               @map("last_imported_at") @db.Timestamptz(3)
  rawMetadata         Json?                  @map("raw_metadata")
  deletedExternallyAt DateTime?              @map("deleted_externally_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection          WebsiteConnection      @relation(fields: [connectionId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)

  @@unique([connectionId, provider, externalPostId])
  @@index([workspaceId, websiteId, status])
  @@index([connectionId, lastImportedAt])
  @@map("external_posts")
}

model ExternalTaxonomyTerm {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  websiteId      String                 @map("website_id") @db.Uuid
  connectionId   String                 @map("connection_id") @db.Uuid
  provider       PublishingProviderType
  type           ExternalTaxonomyType
  name           String                 @db.VarChar(255)
  normalizedName String                 @map("normalized_name") @db.VarChar(255)
  usageCount     Int                    @default(0) @map("usage_count")
  lastSeenAt     DateTime               @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection     WebsiteConnection      @relation(fields: [connectionId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)

  @@unique([connectionId, provider, type, normalizedName])
  @@index([workspaceId, websiteId, type])
  @@map("external_taxonomy_terms")
}

model IntegrationSyncRun {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  websiteId        String                @map("website_id") @db.Uuid
  connectionId     String                @map("connection_id") @db.Uuid
  type             IntegrationSyncType   @default(FULL)
  status           IntegrationSyncStatus @default(PENDING)
  correlationId    String                @map("correlation_id") @db.Uuid
  externalJobId    String?               @map("external_job_id") @db.VarChar(120)
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(3)
  cursor           String?               @db.VarChar(500)
  itemsProcessed   Int                   @default(0) @map("items_processed")
  itemsCreated     Int                   @default(0) @map("items_created")
  itemsUpdated     Int                   @default(0) @map("items_updated")
  itemsFailed      Int                   @default(0) @map("items_failed")
  errorCode        String?               @map("error_code") @db.VarChar(120)
  safeErrorMessage String?               @map("safe_error_message") @db.VarChar(500)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection       WebsiteConnection     @relation(fields: [connectionId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)

  @@unique([correlationId])
  @@index([workspaceId, websiteId, createdAt])
  @@index([connectionId, status])
  @@map("integration_sync_runs")
}

model ProviderPublication {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                       @map("workspace_id") @db.Uuid
  websiteId            String                       @map("website_id") @db.Uuid
  connectionId         String                       @map("connection_id") @db.Uuid
  contentPublicationId String?                      @map("content_publication_id") @db.Uuid
  provider             PublishingProviderType
  idempotencyKey       String                       @map("idempotency_key") @db.VarChar(160)
  operationType        ProviderPublicationOperation @map("operation_type")
  externalPostId       String?                      @map("external_post_id") @db.VarChar(255)
  requestHash          String                       @map("request_hash") @db.Char(64)
  status               ProviderPublicationStatus    @default(PENDING)
  attemptCount         Int                          @default(0) @map("attempt_count")
  lastAttemptAt        DateTime?                    @map("last_attempt_at") @db.Timestamptz(3)
  completedAt          DateTime?                    @map("completed_at") @db.Timestamptz(3)
  safeErrorCode        String?                      @map("safe_error_code") @db.VarChar(120)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection           WebsiteConnection            @relation(fields: [connectionId, workspaceId, websiteId], references: [id, workspaceId, websiteId], onDelete: Cascade)
  contentPublication   ContentPublication?          @relation(fields: [contentPublicationId], references: [id], onDelete: SetNull)

  @@unique([connectionId, provider, idempotencyKey])
  @@unique([contentPublicationId, idempotencyKey], map: "provider_publications_content_publication_id_idempotency_key_ke")
  @@index([workspaceId, websiteId, status])
  @@index([connectionId, externalPostId])
  @@map("provider_publications")
}
