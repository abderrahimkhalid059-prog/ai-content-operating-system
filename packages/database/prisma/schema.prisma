generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WebsitePlatform {
  BLOGGER
  WORDPRESS
  OTHER
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  SEO_MANAGER
  WRITER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContentProfileStatus {
  ACTIVE
  INACTIVE
}

enum JobRecordStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String            @unique @db.VarChar(320)
  displayName        String?           @map("display_name") @db.VarChar(120)
  passwordHash       String            @map("password_hash") @db.VarChar(255)
  status             UserStatus        @default(ACTIVE)
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  securityVersion    Int               @default(1) @map("security_version")
  lastLoginAt        DateTime?         @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?         @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspaceMembers   WorkspaceMember[]
  sessions           Session[]
  auditLogs          AuditLog[]        @relation("AuditActor")

  @@map("users")
}

model Workspace {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String            @db.VarChar(120)
  slug         String            @unique @db.VarChar(100)
  isActive     Boolean           @default(true) @map("is_active")
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  members      WorkspaceMember[]
  websites     Website[]
  settings     SystemSetting[]
  auditLogs    AuditLog[]
  jobRecords   JobRecord[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Website {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String          @db.VarChar(160)
  slug        String          @db.VarChar(120)
  platform    WebsitePlatform
  language    String          @db.VarChar(10)
  locale      String?         @db.VarChar(35)
  timezone    String          @db.VarChar(64)
  description String?         @db.VarChar(1000)
  status      WebsiteStatus   @default(DRAFT)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs   AuditLog[]
  jobRecords  JobRecord[]
  contentProfiles ContentProfile[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("websites")
}

model SystemSetting {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  key         String    @db.VarChar(120)
  value       Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([key])
  @@map("system_settings")
}

model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  websiteId   String?    @map("website_id") @db.Uuid
  actorUserId String?    @map("user_id") @db.Uuid
  targetType  String?    @map("target_type") @db.VarChar(80)
  targetId    String?    @map("target_id") @db.Uuid
  action      String     @db.VarChar(120)
  requestId   String?    @map("request_id") @db.VarChar(128)
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  userAgent   String?    @map("user_agent") @db.VarChar(512)
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  website     Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([websiteId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @map("token_hash") @db.VarChar(128)
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("sessions")
}

model ContentProfile {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  websiteId        String               @map("website_id") @db.Uuid
  name             String               @db.VarChar(160)
  language         String               @db.VarChar(10)
  locale           String?              @db.VarChar(35)
  countryCode      String?              @map("country_code") @db.Char(2)
  tone             String               @db.VarChar(300)
  targetAudience   String?              @map("target_audience") @db.VarChar(500)
  editorialRules   Json                 @map("editorial_rules")
  prohibitedTopics Json?                @map("prohibited_topics")
  isDefault        Boolean              @default(false) @map("is_default")
  status           ContentProfileStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  website          Website              @relation(fields: [websiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([websiteId, name])
  @@index([workspaceId, websiteId, status])
  @@index([websiteId, isDefault, status])
  @@map("content_profiles")
}

model JobRecord {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalJobId String          @map("external_job_id") @db.VarChar(100)
  queue         String          @db.VarChar(100)
  name          String          @db.VarChar(120)
  status        JobRecordStatus @default(WAITING)
  correlationId String          @map("correlation_id") @db.Uuid
  workspaceId   String?         @map("workspace_id") @db.Uuid
  websiteId     String?         @map("website_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  website       Website?        @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@unique([queue, externalJobId])
  @@index([correlationId])
  @@index([workspaceId, status])
  @@index([websiteId, status])
  @@map("job_records")
}
